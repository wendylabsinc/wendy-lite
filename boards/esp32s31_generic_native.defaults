# Generic ESP32-S31 native profile, ESP-IDF 6.1 preview target.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_SPIRAM=n

# OTA overlay: two OTA app slots.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.ota.csv"

# No WASM app support.
CONFIG_WENDY_CORE_WASM_APP_SUPPORT=n
CONFIG_WENDY_WASM=n
CONFIG_WENDY_CALLBACK=n
CONFIG_WENDY_NET=n
CONFIG_WENDY_HAL_GPIO=n
CONFIG_WENDY_HAL_I2C=n
CONFIG_WENDY_HAL_TIMER=n
CONFIG_WENDY_HAL_NEOPIXEL=n
CONFIG_WENDY_HAL_RMT=n
CONFIG_WENDY_BLE_EXPORT=n
