# Append after a physical board profile (and boards/wasm.defaults when used).
# Firmware support is compiled here; persisted WendyCom configuration starts OFF.
CONFIG_WENDY_NET_PEER=y
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_FORWARD=n
CONFIG_LWIP_HOOK_IP6_ROUTE_CUSTOM=y
CONFIG_WENDY_NET_BLE=y
CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=4
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=256
CONFIG_MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH=y
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=2
CONFIG_FREERTOS_TLSP_DELETION_CALLBACKS=y
