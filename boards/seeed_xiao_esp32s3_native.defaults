# 8MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# 8MB octal PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Discover a same-tenant Wi-Fi router, with incoming BLE mesh as fallback.
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_FORWARD=n
CONFIG_LWIP_HOOK_IP6_ROUTE_CUSTOM=y
CONFIG_WENDY_MESH_LEAF=y
CONFIG_WENDY_MESH_WIFI_BLE=y
CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=2
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=256
CONFIG_WENDY_MESH_AUTO_DISCOVER=y

# Bundle the Sense expansion board's camera and PDM microphone over SensorLink.
CONFIG_WENDY_SENSOR_LINK_XIAO_ESP32S3=y

# Keep JPEG frames in PSRAM without direct PSRAM DMA capture stalls.
CONFIG_CAMERA_PSRAM_DMA=n

# Reserve internal memory for sensor DMA and networking/PKI task stacks.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_RX_BA_WIN=4

# OTA overlay: two OTA app slots.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.ota.8mb.csv"

# No WASM app support
CONFIG_WENDY_CORE_WASM_APP_SUPPORT=n
CONFIG_WENDY_WASM=n
CONFIG_WENDY_CALLBACK=n
CONFIG_WENDY_NET=n
CONFIG_WENDY_HAL_GPIO=n
CONFIG_WENDY_HAL_I2C=n
CONFIG_WENDY_HAL_TIMER=n
CONFIG_WENDY_HAL_NEOPIXEL=n
CONFIG_WENDY_HAL_RMT=n
CONFIG_WENDY_BLE_EXPORT=n
