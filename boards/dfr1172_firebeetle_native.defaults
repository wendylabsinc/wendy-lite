# Board overlay: DFRobot DFR1172 FireBeetle 2 ESP32-P4 (16 MB flash, headless),
# native apps.

CONFIG_WENDY_P4_BOARD_NAME="dfr1172_firebeetle_native"

# 16 MB SPI flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# OTA overlay: two OTA app slots.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.ota.16mb.csv"

# No WASM app support
CONFIG_WENDY_CORE_WASM_APP_SUPPORT=n
CONFIG_WENDY_WASM=n
CONFIG_WENDY_CALLBACK=n
CONFIG_WENDY_NET=n
CONFIG_WENDY_HAL_GPIO=n
CONFIG_WENDY_HAL_I2C=n
CONFIG_WENDY_HAL_TIMER=n
CONFIG_WENDY_HAL_NEOPIXEL=n
CONFIG_WENDY_HAL_RMT=n
CONFIG_WENDY_BLE_EXPORT=n
