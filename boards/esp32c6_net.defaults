# Append after the C6 board, optional WASM, and boards/wendy_net.defaults.
# Both carriers compile into one image; WendyCom chooses BLE OR Wi-Fi at runtime.
CONFIG_WENDY_NET_CONSTRAINED_PROFILE=y
CONFIG_WENDY_NET_ENDPOINT_GATEWAY=y
CONFIG_WENDY_NET_SELECT_RADIO_AT_BOOT=y
CONFIG_WENDY_NET_MAX_LINKS=1
CONFIG_WENDY_NET_BLE_CHANNELS=1
CONFIG_WENDY_NET_INTERNAL_MEMORY_LIMIT_KIB=160
CONFIG_WENDY_NET_TASK_STACK_SIZE=14336
CONFIG_WENDY_NET_IO_BYTES=256
CONFIG_WENDY_NET_TCP_RELAY_BUFFER_SIZE=256
CONFIG_WENDY_NET_APP_MAX_FLOWS=1
CONFIG_WENDY_NET_RETAIN_TLS_INPUT=y
# Cloud overlap is outside this constrained profile's qualified headroom.
CONFIG_WENDY_CLOUD=n
# SDK code-placement options reduce internal residency; this is not peer storage.
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
CONFIG_BT_NIMBLE_LOW_SPEED_MODE=y
CONFIG_SPI_FLASH_AUTO_SUSPEND=y

# Match the measured SRAM policy instead of inheriting larger SDK defaults.
CONFIG_WENDY_NET_TASK_PRIORITY=4
CONFIG_WENDY_NET_CRYPTO_TASK_STACK_SIZE=10240
CONFIG_WENDY_SERVER_TASK_STACK_SIZE=16384
CONFIG_WENDY_NET_MANAGEMENT_SETUP_FREE_BYTES=110592
CONFIG_WENDY_NET_PREFER_RTC_PACKET_QUEUE=y
CONFIG_WENDY_NET_RECLAIM_PAYLOADS_FOR_TLS=y
CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=3
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=4
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=2
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_LWIP_MAX_SOCKETS=24
CONFIG_LWIP_TCP_MSS=536

# Optional small guest: one 64 KiB linear memory, no fixed runtime pool.
CONFIG_WENDY_WASM_MAX_MEMORY_PAGES=1
CONFIG_WENDY_WASM_STACK_SIZE=4096
CONFIG_WENDY_WASM_HEAP_SIZE=0
CONFIG_WENDY_WASM_POOL_SIZE=0
CONFIG_WAMR_ENABLE_AOT=y
CONFIG_WENDY_WASM_AOT_XIP=y
CONFIG_ESP_SYSTEM_ALLOW_RTC_FAST_MEM_AS_HEAP=y
CONFIG_WENDY_WASM_PREFER_RTC_RAM=y
CONFIG_WENDY_NET_MAX_SOCKETS=4
CONFIG_WENDY_NET_MAX_LISTENERS=4
CONFIG_WENDY_NET_BUFFER_SIZE=256
CONFIG_WENDY_NET_DATAGRAM_MAX=16384
