# Board overlay: Waveshare ESP32-P4-WIFI6-Touch-LCD-4B (and the
# ESP32-P4-86-Panel-ETH-2RO, which shares the same PCB), native apps.

CONFIG_WENDY_P4_BOARD_NAME="waveshare_lcd_4b_native"

# 32 MB SPI flash (NOR)
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# OTA overlay: two OTA app slots.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.ota.32mb.csv"

# No WASM app support
CONFIG_WENDY_CORE_WASM_APP_SUPPORT=n
CONFIG_WENDY_WASM=n
CONFIG_WENDY_CALLBACK=n
CONFIG_WENDY_NET=n
CONFIG_WENDY_HAL_GPIO=n
CONFIG_WENDY_HAL_I2C=n
CONFIG_WENDY_HAL_TIMER=n
CONFIG_WENDY_HAL_NEOPIXEL=n
CONFIG_WENDY_HAL_RMT=n
CONFIG_WENDY_BLE_EXPORT=n
