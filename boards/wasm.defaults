# Append after sdkconfig.defaults and the board overlay to enable WASM.
CONFIG_WENDY_CORE_WASM_APP_SUPPORT=y
CONFIG_WENDY_WASM=y
CONFIG_WENDY_CALLBACK=y
CONFIG_WENDY_NET=y
CONFIG_WENDY_HAL_GPIO=y
CONFIG_WENDY_HAL_I2C=y
CONFIG_WENDY_HAL_TIMER=y
CONFIG_WENDY_HAL_NEOPIXEL=y
CONFIG_WENDY_HAL_RMT=y
CONFIG_WENDY_BLE_EXPORT=y
