# Native peer overlay for an ESP32-C5 with verified 8 MiB quad PSRAM.
# Append after the board, WASM and boards/wendy_net.defaults.
# Missing PSRAM is tolerated at boot, but the full service/WASM capacity
# measurements require it; inspect the boot log before using this profile.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
# Preserve internal RAM for DMA and task stacks. TLS allocations belong in
# external RAM even when individual certificate/crypto objects are small.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=64
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_MBEDTLS_CUSTOM_MEM_ALLOC=y
CONFIG_WENDY_WASM_USE_PSRAM=y

CONFIG_WENDY_NET_MAX_LINKS=8
CONFIG_WENDY_NET_BLE_CHANNELS=3
CONFIG_WENDY_NET_BLE_SDU_BUFFERS=16
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=4
CONFIG_WENDY_NET_CONSTRAINED_PROFILE=n
CONFIG_WENDY_NET_RECLAIM_PAYLOADS_FOR_TLS=y

# Retained four-link policy: keep controller-facing NimBLE data internal while
# Wi-Fi/lwIP and guest data can use PSRAM. Eight total slots share the existing bounded mesh budget.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=y
CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=5
CONFIG_BT_NIMBLE_L2CAP_COC_SDU_BUFF_COUNT=2
CONFIG_BT_NIMBLE_LOW_SPEED_MODE=y
CONFIG_WENDY_NET_BLE_RX_SDU_SLOTS=2
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_WENDY_NET_TASK_STACK_SIZE=14336
CONFIG_WENDY_NET_TASK_PRIORITY=1
CONFIG_WENDY_NET_CRYPTO_TASK_STACK_SIZE=10240
CONFIG_WENDY_NET_APP_MAX_FLOWS=2
CONFIG_WENDY_SERVER_TASK_STACK_SIZE=16384
CONFIG_WENDY_CLOUD_TASK_STACK_SIZE=16384
CONFIG_LWIP_MAX_SOCKETS=24
CONFIG_SPI_FLASH_AUTO_SUSPEND=y

# Optional guest: preserve 2 MiB mesh headroom beside a 5 MiB linear-memory cap.
CONFIG_WENDY_WASM_MAX_MEMORY_PAGES=80
CONFIG_WENDY_WASM_STACK_SIZE=8192
CONFIG_WENDY_WASM_HEAP_SIZE=0
CONFIG_WENDY_WASM_POOL_SIZE=0
CONFIG_WAMR_ENABLE_AOT=y
CONFIG_WENDY_WASM_AOT_XIP=y
CONFIG_WENDY_NET_MAX_SOCKETS=4
CONFIG_WENDY_NET_MAX_LISTENERS=4
CONFIG_WENDY_NET_BUFFER_SIZE=4096
CONFIG_WENDY_NET_DATAGRAM_MAX=65507
CONFIG_WENDY_NET_BUFFERS_IN_PSRAM=y
