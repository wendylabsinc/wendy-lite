# ESP32-S31-Korvo-1 V1.1: 16 MB flash and 16 MB in-package octal PSRAM.
# ESP-IDF 6.1 still requires --preview for the S31 target.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_200M=y

# Discover a same-tenant Wi-Fi router, with incoming BLE mesh as fallback.
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_FORWARD=n
CONFIG_LWIP_HOOK_IP6_ROUTE_CUSTOM=y
CONFIG_WENDY_MESH_LEAF=y
CONFIG_WENDY_MESH_WIFI_BLE=y
CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=2
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=256
CONFIG_WENDY_MESH_AUTO_DISCOVER=y

# Keep both HP cores available. PIE/SIMD executes on CPU1 only; native apps
# should schedule DSP there. These CPU settings match the S31 SDK defaults.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
CONFIG_FREERTOS_UNICORE=n
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# The Type-C programming port is a USB-to-UART bridge, not native USB/JTAG.
# Keep boot/panic diagnostics; Wendy's stdio hook owns ordinary UART0 I/O.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_WENDY_USJ_USE_UART=y
CONFIG_WENDY_USJ_UART_TX_GPIO=58
CONFIG_WENDY_USJ_UART_RX_GPIO=59

# Large buffers can use PSRAM; preserve internal RAM for DMA and task stacks.
# XiP is left off to keep instruction fetches off the frame-buffer PSRAM bus.
CONFIG_SPIRAM_XIP_FROM_PSRAM=n
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304

# Use the SDK's PSRAM Wi-Fi buffer sizes and a bounded 12-MSS TCP window.
# The receive mailbox has two spare slots, as recommended by lwIP Kconfig.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=16
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=17280
CONFIG_LWIP_TCP_WND_DEFAULT=17280
CONFIG_LWIP_TCP_RECVMBOX_SIZE=14

# Bundle the onboard DVP camera and ES8389 dual-microphone input.
CONFIG_WENDY_SENSOR_LINK_ESP32S31_KORVO_1=y
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=y
CONFIG_CAMERA_XCLK_USE_LEDC=y
CONFIG_CAMERA_OV3660=y
CONFIG_CAMERA_OV3660_DVP_JPEG_640X480_25FPS=y
CONFIG_CAMERA_OV3660_DVP_DEFAULT_FMT_JPEG_640X480_25FPS=y
CONFIG_CAMERA_SC101IOT=y
CONFIG_CAMERA_SC101IOT_DVP_YUV422_640X480_15FPS=y
CONFIG_CAMERA_SC101IOT_DVP_DEFAULT_FMT_YUV422_640X480_15FPS=y

# Show a native status page on the optional 800x480 SUB3 RGB display.
CONFIG_WENDY_DISPLAY_ESP32S31_KORVO_1=y

# Two equal OTA app slots, with the existing PKI/config partition sizes.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.ota.16mb.csv"

# The pinned WAMR component does not support ESP32-S31.
CONFIG_WENDY_CORE_WASM_APP_SUPPORT=n
CONFIG_WENDY_WASM=n
CONFIG_WENDY_CALLBACK=n
CONFIG_WENDY_NET=n
CONFIG_WENDY_HAL_GPIO=n
CONFIG_WENDY_HAL_I2C=n
CONFIG_WENDY_HAL_TIMER=n
CONFIG_WENDY_HAL_NEOPIXEL=n
CONFIG_WENDY_HAL_RMT=n
CONFIG_WENDY_BLE_EXPORT=n
