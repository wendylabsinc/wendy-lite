+
+bool wendy_espnow_sdio_send(const uint8_t *bytes, size_t size)
+{
+	if (!datapath || !size || size > WNE_SDIO_MAX_BYTES)
+		return false;
+	uint8_t *copy = malloc(size);
+	if (!copy)
+		return false;
+	memcpy(copy, bytes, size);
+	interface_buffer_handle_t packet = {
+		.if_type = WNE_SDIO_INTERFACE, .payload = copy, .payload_len = size,
+		.priv_buffer_handle = copy, .free_buf_handle = free,
+	};
+	if (send_to_host_queue(&packet, PRIO_Q_OTHERS) == ESP_OK)
+		return true;
+	free(copy);
+	return false;
 }
 
