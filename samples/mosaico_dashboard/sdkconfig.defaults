CONFIG_IDF_TARGET="esp32s31"
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# Preserve Wendy's 8 MB OTA offsets and add crash storage in Mosaico's 16 MB
# program flash. Both app slots fit the display and board support libraries.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Confirm only after Wendy services and the dashboard have initialized. Keep
# failures before that point eligible for rollback and visible over USB.
CONFIG_BOOTLOADER_APP_ROLLBACK_CONFIRM_BY_APP=y

# The BSP display needs external RAM. Match its S31 PSRAM configuration.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Keep ordinary LVGL and protocol allocations in PSRAM; internal RAM is needed
# by DMA, radio buffers and task stacks.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=64
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=131072
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_FREERTOS_HZ=1000

CONFIG_BSP_DISPLAY_ENABLE=y
CONFIG_BSP_DISPLAY_LVGL_ENABLE=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y

# Wendy owns Wi-Fi, BLE and USB-C CDC. Keep ROM logs on UART.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_WENDY_DEVICE_NAME_DEFAULT_PREFIX="mosaico"

# Signed mesh with automatic Wi-Fi discovery and incoming BLE fallback.
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_FORWARD=n
CONFIG_LWIP_HOOK_IP6_ROUTE_CUSTOM=y
CONFIG_WENDY_NET_PEER=y
CONFIG_WENDY_NET_BLE=y
CONFIG_WENDY_NET_CONSTRAINED_PROFILE=n
CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=4
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=256

# Match the BSP LVGL integration: use FreeRTOS locks and the PSRAM-capable heap.
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y

# Runtime startup diagnostics on Mosaico's USB-C OTG port.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=2
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Mosaico"

# Retain the panic location across reboot for USB diagnostics.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_STACK_SIZE=2048

# USB-C CDC 0 is Wendy management; CDC 1 is independent diagnostics.
CONFIG_WENDY_USJ=n

# SensorLink uses the left-slot camera and onboard ES8311 microphone.
CONFIG_WENDY_SENSOR_LINK_MOSAICO=y
CONFIG_MOSAICO_MODULE_CAMERA=y
CONFIG_CAMERA_OV3640_DVP_DEFAULT_FMT_YUV422_UYVY_1280X720_15FPS=y
# GPIO33 is camera D2; USB-C management uses the separate OTG controller.
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n

# Leave DMA memory for DVP and I2S instead of reserving 16 Wi-Fi TX buffers.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8

# Mesh adds actor and crypto tasks alongside the display, sensors and Cloud.
# Use the PSRAM mesh profile's radio and task budgets to retain internal DMA
# memory for BLE and hardware AES during signed-time/TLS authentication.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=8
CONFIG_WENDY_NET_TASK_STACK_SIZE=14336
CONFIG_WENDY_NET_TASK_PRIORITY=1
CONFIG_WENDY_SERVER_TASK_STACK_SIZE=16384
CONFIG_WENDY_CLOUD_TASK_STACK_SIZE=16384
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y

CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=2
CONFIG_FREERTOS_TLSP_DELETION_CALLBACKS=y
CONFIG_MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH=y
