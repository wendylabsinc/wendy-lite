# Universal Wendy firmware defaults.
# Target-specific overrides live in sdkconfig.defaults.<target>:
#   - sdkconfig.defaults.esp32c6   (single-chip board)
#   - sdkconfig.defaults.esp32p4   (FireBeetle 2 ESP32-P4 + on-board C6)

# WasmKit Embedded Swift runtime configuration.
# (WAMR and its managed component are no longer used on this branch.)
CONFIG_WENDY_WASM_STACK_SIZE=16384
CONFIG_WENDY_WASM_HEAP_SIZE=32768
CONFIG_WENDY_WASM_POOL_SIZE=163840

# Wendy HAL defaults
CONFIG_WENDY_HAL_GPIO=y
CONFIG_WENDY_HAL_I2C=y
CONFIG_WENDY_HAL_TIMER=y
CONFIG_WENDY_HAL_NEOPIXEL=y

# Callback subsystem
CONFIG_WENDY_CALLBACK=y

# System functions
CONFIG_WENDY_SYS=y

# NVS storage
CONFIG_WENDY_STORAGE=y

# UART
CONFIG_WENDY_UART=y

# SPI
CONFIG_WENDY_SPI=y

# OpenTelemetry
CONFIG_WENDY_OTEL=y

# WASI shim
CONFIG_WENDY_WASI_SHIM=y

# BLE stack (NimBLE) - runs on the host MCU regardless of whether the
# controller is native (C6) or remote-over-VHCI via esp_hosted (P4).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2

# BLE provisioning and discovery
CONFIG_WENDY_BLE_PROV=y

# Cloud provisioning (device certificates via BLE)
CONFIG_WENDY_CLOUD_PROV=y

# Cloud mTLS connection
CONFIG_WENDY_CLOUD_ENABLED=n

# mbedTLS memory — dynamic buffers avoid a large upfront allocation at ssl_setup
# time. Without this, mbedtls_ssl_setup fails with MBEDTLS_ERR_SSL_ALLOC_FAILED
# (-0x7F00) because WiFi+BLE+WAMR leave insufficient contiguous heap.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_PEER_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192

# mbedTLS flash footprint cuts.
#
# Default cert (and all Wendy-issued provisioning certs) are ECDSA/P-256.
# RSA key-exchange cipher suites therefore add ~30 KB of dead crypto code.
# If you need to accept RSA client certificates, re-enable these three.
# CONFIG_MBEDTLS_KEY_EXCHANGE_RSA is not set
# CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_RSA is not set
# CONFIG_MBEDTLS_KEY_EXCHANGE_ECDH_RSA is not set

# ALPN is not used by the wcom binary protocol.
# CONFIG_MBEDTLS_SSL_ALPN is not set

# TLS renegotiation is deprecated and a known attack surface.
# CONFIG_MBEDTLS_SSL_RENEGOTIATION is not set

# PEM write is only needed for generating PEM output; we only ever parse.
# CONFIG_MBEDTLS_PEM_WRITE_C is not set

# CA bundle: the full bundle (~67 KB rodata, 200+ root CAs) is only needed
# if WASM apps make outbound HTTPS connections to arbitrary hosts. Switch to
# the common subset (~15 KB) unless your WASM workloads require obscure CAs.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL is not set

# App-facing BLE host functions disabled by default
# CONFIG_WENDY_BLE is not set

# App-facing networking (sockets, DNS, TLS)
CONFIG_WENDY_NET=y

# WiFi transport for WASM download
CONFIG_WENDY_WIFI_ENABLED=y
CONFIG_WENDY_WIFI_SSID=""
CONFIG_WENDY_WIFI_PASSWORD=""

# Console over UART (compatible with Wokwi and most debug setups)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# --- Memory optimizations ---

# Size-optimized build (-Os instead of -Og)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTION_LEVEL=1

# Disable stack overflow canary (saves RAM per task)
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_NONE=y

# Log level WARN: eliminates all ESP_LOGI format strings from flash rodata
# (~85 KB+ across components). Set to INFO for debugging, WARN for production.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# CONFIG_LOG_DEFAULT_LEVEL_INFO is not set

# Tune NimBLE buffer pools (sized for max 2 connections). These apply
# regardless of whether the controller is native or remote.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=4
