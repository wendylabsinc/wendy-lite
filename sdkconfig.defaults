# Universal Wendy firmware defaults.
# Target-specific overrides live in sdkconfig.defaults.<target>:
#   - sdkconfig.defaults.esp32c6   (single-chip board)
#   - sdkconfig.defaults.esp32p4   (FireBeetle 2 ESP32-P4 + on-board C6)

# WASM is opt-in via boards/wasm.defaults.
CONFIG_WENDY_CORE_WASM_APP_SUPPORT=n
CONFIG_WENDY_WASM=n
CONFIG_WENDY_CALLBACK=n
CONFIG_WENDY_HAL_GPIO=n
CONFIG_WENDY_HAL_I2C=n
CONFIG_WENDY_HAL_TIMER=n
CONFIG_WENDY_HAL_NEOPIXEL=n
CONFIG_WENDY_HAL_RMT=n
CONFIG_WENDY_BLE_EXPORT=n

# WAMR configuration (interpreter/AOT/loader knobs are picked per-target -
# tiny C6 builds prefer classic + mini loader; the P4 with PSRAM uses fast.)
CONFIG_WENDY_WASM_STACK_SIZE=8192
CONFIG_WENDY_WASM_HEAP_SIZE=0
# 0 = use system allocator (no pre-allocated pool). Trades the hard guest
# ceiling for letting wifi DMA buffers and the wasm runtime share heap
# dynamically. With a 224 KiB pre-allocated pool on ESP32-C6, the DMA pool
# was being starved to single bytes, breaking outbound wifi entirely.
CONFIG_WENDY_WASM_POOL_SIZE=0

# Bytecode/interpreter-only runtime: trim optional WAMR subsystems.
# CONFIG_WAMR_ENABLE_AOT is not set
# CONFIG_WAMR_ENABLE_APP_FRAMEWORK is not set

# Disable WAMR pthread (causes assert in FreeRTOS tasks)
# CONFIG_WAMR_ENABLE_LIB_PTHREAD is not set
# CONFIG_WAMR_ENABLE_SHARED_MEMORY is not set

# Disable WAMR built-in WASI (we provide our own shim)
# CONFIG_WAMR_ENABLE_LIBC_WASI is not set
# CONFIG_WAMR_ENABLE_MEMORY_PROFILING is not set

# Swift async executables need WAMR ref-types support for their funcref table.
CONFIG_WAMR_ENABLE_REF_TYPES=y

# BLE stack (NimBLE) - runs on the host MCU regardless of whether the
# controller is native (C6) or remote-over-VHCI via esp_hosted (P4).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2

# WendyCom over mTLS over BLE. The wendy_ble component owns the NimBLE stack:
# it is the only caller of nimble_port_init().
CONFIG_WENDY_BLE=y

# L2CAP connection-oriented channels carry the WendyCom byte stream. Defaults
# to 0 (compiled out), so this is what makes the transport possible at all.
CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247

# The bundled mbedTLS reassembles handshake records against its configured
# input size. IDF's dynamic allocator can allocate only the current record's
# size, so use fixed buffers to keep that bound equal to the allocation.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=n
# Mixed ML-DSA-65/87 chains need full TLS records plus handshake reassembly.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
# Use the system allocator so boards with PSRAM can keep large TLS buffers
# outside the internal RAM reserved for DMA and task stacks.
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y

# App-facing networking (sockets, DNS, TLS)
CONFIG_WENDY_NET=n

# Console over UART (compatible with Wokwi and most debug setups)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# Disable ROM secondary console so the wendy_usj buffered driver owns the USB
# Serial/JTAG peripheral exclusively (no TX FIFO conflict with esp_rom_usb_serial_putc).
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- Memory optimizations ---

# Size-optimized build (-Os instead of -Og)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTION_LEVEL=1

# Disable stack overflow canary (saves RAM per task)
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_NONE=y

# Tune NimBLE buffer pools (sized for max 2 connections). These apply
# regardless of whether the controller is native or remote.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=4

# no need for TERMIOS
CONFIG_SUPPORT_TERMIOS=n

# Take over the bootloader RTC watchdog explicitly in wendy_core_init() instead
# of relying on ESP-IDF's automatic disable before app_main(). Keep it armed
# with a real 40s timeout: wendy_core_wdt.c derives its feed period from the
# timeout below and feeds it only while the wendy_com task stays responsive.
CONFIG_WENDY_CORE_WATCHDOG=y
CONFIG_BOOTLOADER_WDT_DISABLE_IN_USER_CODE=y
CONFIG_BOOTLOADER_WDT_TIME_MS=40000

# Start the enrollment task when Wi-Fi connects and enrollment is configured.
CONFIG_WENDY_CLOUD=y

# esp-pqc verifies ML-DSA-65 identities/timestamps and ML-DSA-65/87 CAs.
# Device keys and relay grants remain P-256; PQ key exchange is not required.
CONFIG_LIBOQS_ENABLED=y
CONFIG_LIBOQS_ENABLE_SIG_ML_DSA=y
CONFIG_LIBOQS_ENABLE_KEM_ML_KEM=n
CONFIG_LIBOQS_MLD_HEAP_TEMPORARIES=y
CONFIG_LIBOQS_MLD_VERIFY_ONLY=y
CONFIG_LIBOQS_MINIMAL_COMMON=y
CONFIG_MBEDTLS_USE_BUNDLED_PQC=y
CONFIG_MBEDTLS_SSL_TLS1_3_SIG_MLDSA65=y
CONFIG_MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_GROUP_X25519MLKEM768=n

# PKI uses TLS 1.3 through the bundled esp-pqc mbedTLS component.
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=y

# Sigstore RFC 3161 timestamps use P-384 TSA certificates and SHA-384 chains.
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=y
CONFIG_MBEDTLS_SHA512_C=y

# Mesh task reservations use slot 1; ESP-IDF reserves slot 0.
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=2
CONFIG_FREERTOS_TLSP_DELETION_CALLBACKS=y
