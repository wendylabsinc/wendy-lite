# Marks wendy_core as part of the build. ESP-IDF only sources the Kconfig of
# components in the build closure, so this is y exactly when a project depends
# on wendy_core (directly or transitively) and the symbol does not exist at all
# otherwise. No prompt, so it is invisible in menuconfig and an assignment in
# sdkconfig or an sdkconfig.defaults overlay is ignored.
config WENDY_CORE
    bool
    default y

menu "Wendy Core"
    # 0.0.0 marks a build that is not a release. Release builds get the real
    # version injected from the vX.Y.Z git tag by .github/workflows/build.yml,
    # via a generated version.defaults overlay appended last to
    # SDKCONFIG_DEFAULTS -- so do not read the values below as the version of a
    # tagged commit.
    config WENDY_FIRMWARE_VERSION_MAJOR
        int "Firmware version major"
        default 0

    config WENDY_FIRMWARE_VERSION_MINOR
        int "Firmware version minor"
        default 0

    config WENDY_FIRMWARE_VERSION_PATCH
        int "Firmware version patch"
        default 0

    config WENDY_P4_BOARD_NAME
        string "ESP32-P4 board name"
        default ""
        help
            Identifies the selected ESP32-P4 board variant. Set to a non-empty
            value by a boards/<board>.defaults overlay (selected via the
            matching boards/<board>.cfg argfile). The top-level CMakeLists.txt
            aborts an esp32p4 build when this is empty, since P4 boards differ
            in flash size and partition layout. Unused on non-P4 targets.

    config WENDY_CORE_WATCHDOG
        bool "Enable the RTC watchdog"
        default n
        depends on BOOTLOADER_WDT_DISABLE_IN_USER_CODE
        help
            Keep the RTC watchdog the bootloader armed running for the whole
            life of the firmware instead of only over startup. It is fed from
            a periodic timer, but only through the wendy_com task, so a wedged
            wendy_com task lets the watchdog run out and reset the board.

            The timeout is BOOTLOADER_WDT_TIME_MS and the feed period is
            derived from it, so changing the timeout cannot silently break the
            margin between the two.

            Depends on BOOTLOADER_WDT_DISABLE_IN_USER_CODE, which is what
            stops ESP-IDF from disabling the RTC watchdog before app_main().
            Turning this off therefore belongs together with turning that off:
            clearing this one alone leaves the RTC watchdog armed with nothing
            feeding it, and the board resets BOOTLOADER_WDT_TIME_MS into the
            firmware.

    config WENDY_CORE_WASM_APP_SUPPORT
        bool "Enable WASM app support"
        default n
        help
            Enable the ability to run WASM applications on the device.
endmenu
