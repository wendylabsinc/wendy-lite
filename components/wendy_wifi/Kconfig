menu "Wendy WiFi Communication"
    config WENDY_WIFI_ENABLED
        bool "Enable WiFi transport"
        default y
        help
            Connect to WiFi and enable advertisement via mDNS.

    config WENDY_WIFI_TEST_DISABLE_POWER_SAVE
        bool "Investigate station operation without modem power saving"
        depends on WENDY_WIFI_ENABLED
        default n
        help
            Set WIFI_PS_NONE after station startup for controlled lab trials.
            Compare ordinary ACK/disconnect behavior with the default modem
            sleep policy. This may increase radio power consumption; no power
            saving claim is implied. Saved credentials are unchanged.

    config WENDY_WIFI_TEST_PSRAM_THROUGHPUT
        bool "Qualify larger TCP windows on a PSRAM networking board"
        default n
        help
            Opt-in lab profile for ESP32-C5 and ESP32-S3 with required PSRAM.
            Append boards/network_throughput_psram.defaults to the board's
            defaults. The build rejects unsupported targets, missing PSRAM,
            stale window/buffer settings and insufficient internal reserve.
            Defaults alone do not update an existing sdkconfig. This profile
            uses more network memory and needs hardware latency/heap testing
            before being selected for release firmware.

    config WENDY_WIFI_TEST_MAX_11N
        bool "Investigate station ACK loss with an 802.11n protocol limit"
        depends on WENDY_WIFI_ENABLED
        default n
        help
            Limit the station protocol to b/g/n on 2.4GHz and a/n on 5GHz.
            Compare ordinary connection stability against the default HE mode
            on the same lab AP. Saved credentials and TLS are unchanged.

    config WENDY_WIFI_SSID
        string "WiFi SSID"
        depends on WENDY_WIFI_ENABLED
        default ""

    config WENDY_WIFI_PASSWORD
        string "WiFi password"
        depends on WENDY_WIFI_ENABLED
        default ""

endmenu
