menu "Wendy USB Communication"
    config WENDY_USB_CDC_ENABLED
        bool "Enable USB CDC protocol"
        depends on SOC_USB_OTG_SUPPORTED
        default n
        help
            Host-side TinyUSB CDC channel used to upload WASM
            guests over USB. Requires a SoC with native USB OTG
            (ESP32-S2/S3/P4) and the esp_tinyusb managed
            component. Off by default on every target.

    config WENDY_USB_PROTOCOL_VERSION
        int "USB protocol version"
        default 1

    config WENDY_USB_CHUNK_SIZE
        int "Upload chunk size (bytes)"
        default 4096
endmenu
