menu "Wendy SensorLink"
    config WENDY_SENSOR_LINK_XIAO_ESP32S3
        bool "Bundle XIAO ESP32S3 Sense camera and microphone"
        default n
        depends on IDF_TARGET_ESP32S3 && !WENDY_CORE_WASM_APP_SUPPORT
        help
            Expose the Seeed Studio XIAO ESP32S3 Sense expansion board's
            camera and PDM microphone through SensorLink in native firmware.
            Supports 800x600 MJPEG video and 16 kHz mono PCM audio, which can
            stream concurrently. Requires PSRAM and the Sense camera/microphone
            board.
            Other ESP32-S3 boards may use different pins and must leave this
            disabled.

    config WENDY_SENSOR_LINK_ESP32S31_KORVO_1
        bool "Bundle ESP32-S31-Korvo-1 camera and dual microphones"
        default n
        depends on IDF_TARGET_ESP32S31 && !WENDY_CORE_WASM_APP_SUPPORT
        help
            Expose the Korvo-1 V1.1 DVP camera and ES8389 microphones through
            SensorLink. Camera and audio can stream concurrently. Uses two
            PSRAM camera buffers, hardware JPEG for raw sensors, and 16 kHz
            stereo PCM audio. Requires the Korvo camera module and PSRAM;
            configuration fails if PSRAM is disabled.
    config WENDY_SENSOR_LINK_MOSAICO
        bool "Bundle ESP-Mosaico camera and microphone"
        default n
        depends on IDF_TARGET_ESP32S31 && !WENDY_CORE_WASM_APP_SUPPORT && !WENDY_SENSOR_LINK_ESP32S31_KORVO_1
        help
            Expose the left-slot Mosaico camera module as 1280x720 MJPEG
            and the onboard ES8311 microphone as 16 kHz mono PCM. Both
            streams can run concurrently. Requires PSRAM and the Mosaico
            BSP. A missing camera does not prevent microphone streaming.
endmenu
