menu "Wendy SensorLink"
    config WENDY_SENSOR_LINK_XIAO_ESP32S3
        bool "Bundle XIAO ESP32S3 Sense camera and microphone"
        default n
        depends on IDF_TARGET_ESP32S3 && !WENDY_CORE_WASM_APP_SUPPORT
        help
            Expose the Seeed Studio XIAO ESP32S3 Sense expansion board's
            camera and PDM microphone through SensorLink in native firmware.
            Supports 800x600 MJPEG video or 16 kHz mono PCM audio, one stream
            at a time. Requires PSRAM and the Sense camera/microphone board.
            Other ESP32-S3 boards may use different pins and must leave this
            disabled.
endmenu
