menu "Wendy wired console and management"
    config WENDY_USJ
        bool "Enable wired console and management"
        depends on SOC_USB_SERIAL_JTAG_SUPPORTED
        default y if SOC_USB_SERIAL_JTAG_SUPPORTED
        help
            Installs the selected serial driver to output logs and accept
            device management through the WendyCom protocol.

    config WENDY_USJ_USE_UART
        bool "Use UART0 through a USB-to-UART bridge"
        depends on WENDY_USJ && SOC_UART_SUPPORTED && ESP_CONSOLE_UART && ESP_CONSOLE_UART_NUM = 0
        default n
        help
            Use a board's UART0 programming bridge for the Wendy console and
            WendyCom at 115200 baud, instead of native USB Serial/JTAG.
            Keep the ESP-IDF console on UART0 for boot and panic diagnostics.
            Wendy's stdio hook takes ownership of ordinary input and output
            after startup, routing logs only when in console mode.

    config WENDY_USJ_UART_TX_GPIO
        int "UART0 TX GPIO"
        depends on WENDY_USJ_USE_UART
        default 58 if IDF_TARGET_ESP32S31
        default -1
        range -1 61

    config WENDY_USJ_UART_RX_GPIO
        int "UART0 RX GPIO"
        depends on WENDY_USJ_USE_UART
        default 59 if IDF_TARGET_ESP32S31
        default -1
        range -1 61

    config WENDY_USJ_TASK_PRIORITY
        int "USJ task priority"
        depends on WENDY_USJ
        default 2
        range 1 24

    choice WENDY_USJ_TASK_CORE_AFFINITY
        prompt "USJ task core affinity"
        depends on WENDY_USJ
        default WENDY_USJ_TASK_CORE_AFFINITY_NO_AFFINITY
        help
            Core affinity of the wendy_usj task.

        config WENDY_USJ_TASK_CORE_AFFINITY_CPU0
            bool "Core 0"
        config WENDY_USJ_TASK_CORE_AFFINITY_CPU1
            bool "Core 1"
            depends on !FREERTOS_UNICORE
        config WENDY_USJ_TASK_CORE_AFFINITY_NO_AFFINITY
            bool "No affinity"
    endchoice

    config WENDY_USJ_TASK_CORE_AFFINITY
        hex
        depends on WENDY_USJ
        default 0x0 if WENDY_USJ_TASK_CORE_AFFINITY_CPU0
        default 0x1 if WENDY_USJ_TASK_CORE_AFFINITY_CPU1
        default FREERTOS_NO_AFFINITY if WENDY_USJ_TASK_CORE_AFFINITY_NO_AFFINITY
endmenu
