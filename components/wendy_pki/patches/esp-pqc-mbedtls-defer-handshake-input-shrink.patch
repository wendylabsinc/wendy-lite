--- a/include/mbedtls/ssl.h
+++ b/include/mbedtls/ssl.h
@@ -1362,6 +1362,11 @@
     /* Opt-in native endpoint mode: borrow wire issuer DER only during full
      * path verification, then retain an independently owned peer leaf. */
     uint8_t MBEDTLS_PRIVATE(wendy_compact_peer_chain);
+#if defined(MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH)
+    /* Opt-in: retain the handshake input until an explicit safe idle compact.
