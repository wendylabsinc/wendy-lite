+/* Application streams retain one small record and grow on demand. Never move
+ * a live application pointer or partial/fragmented record. A failed shrink is
+ * harmless; the existing larger allocation remains owned by the context. */
+void mbedtls_ssl_compact_input_buffer(mbedtls_ssl_context *ssl)
+{
+    if (ssl->conf->transport == MBEDTLS_SSL_TRANSPORT_STREAM &&
+        ssl->state == MBEDTLS_SSL_HANDSHAKE_OVER && ssl->in_offt == NULL &&
+        ssl->in_left == 0 && ssl->in_msglen == 0 && ssl->in_hsfraglen == 0 &&
+        ssl->in_hslen == 0 && (size_t)(ssl->in_msg-ssl->in_buf)<2048 &&
+        (size_t)(ssl->in_hdr-ssl->in_buf)<2048) {
+        handle_buffer_resizing(ssl,1,2048,ssl->out_buf_len);
     }
 }
 
