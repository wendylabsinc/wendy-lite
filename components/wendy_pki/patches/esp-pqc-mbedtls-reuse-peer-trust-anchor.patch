+/* A non-leaf certificate identical to a configured CA need not be parsed
+ * twice. It remains available to path validation from the pinned CA chain.
+ * The complete original message still contributes to the TLS transcript. */
+static int ssl_tls13_duplicate_anchor(mbedtls_ssl_context *ssl,
+                                      const unsigned char *der, size_t length)
+{
+    const mbedtls_x509_crt *root = ssl->conf->ca_chain;
+#if defined(MBEDTLS_SSL_SERVER_NAME_INDICATION)
+    if (ssl->handshake->sni_ca_chain != NULL) root = ssl->handshake->sni_ca_chain;
+#endif
+    for (; root != NULL; root = root->next) {
+        if (root->ca_istrue && root->raw.len == length && root->raw.p != NULL &&
+            memcmp(root->raw.p, der, length) == 0) return 1;
+    }
+    return 0;
+}
