diff --git a/tf-psa-crypto/include/mbedtls/pk.h b/tf-psa-crypto/include/mbedtls/pk.h
--- a/tf-psa-crypto/include/mbedtls/pk.h
+++ b/tf-psa-crypto/include/mbedtls/pk.h
@@ -142,6 +142,7 @@
      * by psa_export_public_key(). */
     uint8_t MBEDTLS_PRIVATE(pub_raw)[MBEDTLS_PK_MAX_PUBKEY_RAW_LEN];
     uint8_t *MBEDTLS_PRIVATE(pqc_raw);
+    unsigned char MBEDTLS_PRIVATE(pqc_raw_borrowed);
 
     /* Lenght of the raw key above in bytes. */
     size_t MBEDTLS_PRIVATE(pub_raw_len);
diff --git a/tf-psa-crypto/extras/pk.c b/tf-psa-crypto/extras/pk.c
--- a/tf-psa-crypto/extras/pk.c
+++ b/tf-psa-crypto/extras/pk.c
@@ -42,6 +42,7 @@
     ctx->psa_type = PSA_KEY_TYPE_NONE;
     memset(ctx->pub_raw, 0, sizeof(ctx->pub_raw));
     ctx->pqc_raw = NULL;
+    ctx->pqc_raw_borrowed = 0;
     ctx->pub_raw_len = 0;
     ctx->bits = 0;
 #if defined(PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY)
@@ -64,7 +65,7 @@
         psa_destroy_key(ctx->priv_id);
     }
 
-    mbedtls_free(ctx->pqc_raw);
+    if (!ctx->pqc_raw_borrowed) mbedtls_free(ctx->pqc_raw);
     /* Leaves the context in the same state as mbedtls_pk_init(). */
     mbedtls_platform_zeroize(ctx, sizeof(mbedtls_pk_context));
 }
diff --git a/tf-psa-crypto/extras/pkparse.c b/tf-psa-crypto/extras/pkparse.c
--- a/tf-psa-crypto/extras/pkparse.c
+++ b/tf-psa-crypto/extras/pkparse.c
@@ -512,8 +512,8 @@
  *       algorithm            AlgorithmIdentifier,
  *       subjectPublicKey     BIT STRING }
  */
-int mbedtls_pk_parse_subpubkey(unsigned char **p, const unsigned char *end,
-                               mbedtls_pk_context *pk)
+static int pk_parse_subpubkey(unsigned char **p, const unsigned char *end,
+                               mbedtls_pk_context *pk, int copy)
 {
     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
     size_t len;
@@ -585,10 +585,16 @@
         size_t expected = pk_alg == MBEDTLS_PK_MLDSA65 ? 1952 : 2592;
         if (len != expected) {
             ret = MBEDTLS_ERR_PK_INVALID_PUBKEY;
-        } else if ((pk->pqc_raw = mbedtls_calloc(1, len)) == NULL) {
-            ret = MBEDTLS_ERR_PK_ALLOC_FAILED;
         } else {
-            memcpy(pk->pqc_raw, *p, len);
+            if (copy) {
+                pk->pqc_raw = mbedtls_calloc(1, len);
+                if (pk->pqc_raw == NULL) { ret = MBEDTLS_ERR_PK_ALLOC_FAILED; goto cleanup; }
+                memcpy(pk->pqc_raw, *p, len);
+            } else {
+                /* Certificate DER outlives its parsed public-key view. */
+                pk->pqc_raw = *p;
+                pk->pqc_raw_borrowed = 1;
+            }
             pk->pub_raw_len = len;
             pk->bits = len * 8;
             *p += len;
@@ -604,11 +610,24 @@
                                 MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);
     }
 
+cleanup:
     if (ret != 0) {
         mbedtls_pk_free(pk);
     }
 
     return ret;
+}
+
+int mbedtls_pk_parse_subpubkey(unsigned char **p, const unsigned char *end,
+                               mbedtls_pk_context *pk)
+{
+    return pk_parse_subpubkey(p, end, pk, 1);
+}
+
+int mbedtls_pk_parse_subpubkey_nocopy(unsigned char **p, const unsigned char *end,
+                                      mbedtls_pk_context *pk)
+{
+    return pk_parse_subpubkey(p, end, pk, 0);
 }
 
 #if defined(PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY)
diff --git a/tf-psa-crypto/include/mbedtls/private/pk_private.h b/tf-psa-crypto/include/mbedtls/private/pk_private.h
--- a/tf-psa-crypto/include/mbedtls/private/pk_private.h
+++ b/tf-psa-crypto/include/mbedtls/private/pk_private.h
@@ -132,6 +132,10 @@
  */
 int mbedtls_pk_parse_subpubkey(unsigned char **p, const unsigned char *end,
                                mbedtls_pk_context *pk);
+/* Internal certificate parser only: input DER must outlive the key context.
+ * EC/RSA behavior is unchanged; ML-DSA keys borrow their immutable DER bytes. */
+int mbedtls_pk_parse_subpubkey_nocopy(unsigned char **p, const unsigned char *end,
+                                      mbedtls_pk_context *pk);
 #endif /* MBEDTLS_PK_PARSE_C */
 
 #if defined(MBEDTLS_PK_WRITE_C)
diff --git a/library/x509_crt.c b/library/x509_crt.c
--- a/library/x509_crt.c
+++ b/library/x509_crt.c
@@ -1237,7 +1237,7 @@
      * SubjectPublicKeyInfo
      */
     crt->pk_raw.p = p;
-    if ((ret = mbedtls_pk_parse_subpubkey(&p, end, &crt->pk)) != 0) {
+    if ((ret = mbedtls_pk_parse_subpubkey_nocopy(&p, end, &crt->pk)) != 0) {
         mbedtls_x509_crt_free(crt);
         return ret;
     }
