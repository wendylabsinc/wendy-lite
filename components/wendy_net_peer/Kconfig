        default 60
        range 10 900
        depends on WENDY_NET_TEST_LAN_PAUSE_AFTER > 0
    config WENDY_NET_TEST_TIME_RELAY
        bool "Integration test: fetch signed time through the discovered peer"
        default n
        depends on WENDY_NET_PEER
        help
            Uses the finite WNT1 lab relay on TCP43025 instead of allocating a
