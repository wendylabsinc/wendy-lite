    config WENDY_NET_TEST_ACCEPT_ONLY
        bool "Integration test: accept connections without initiating dials"
        default n
        depends on WENDY_NET_PEER
        help
            Exercises discovery and reverse dialing from WendyOS in the lab.
            Normal peers keep both accepting and initiating connections.
    config WENDY_NET_TEST_ECHO_SERVICE
        bool "Integration test: bounded TLS echo service on app port28081"
        default n
        depends on WENDY_NET_PEER
        help
            A native echo sink for throughput and headroom measurements.
            It is not part of the production service authorization table.
    config WENDY_NET_TEST_APP_CLIENT
        bool "Integration test: dial neighbor's signed TLS app endpoint"
        default n
        depends on WENDY_NET_ROUTER
        help
            Attempt a bounded65536-byte random echo through the current
            neighbor's signed TLS endpoint. Uses its mesh IPv6 address, full
            device mTLS and WAS1 service selection. Receiver must explicitly
            enable the lab echo service. One transient16KiB handshake task;
            retry at most once a minute until the first successful echo.
    config WENDY_NET_TEST_AGENT_PROXY
        bool "Integration test: opaque operator TCP bridge to a signed mesh agent"
        default n
        depends on WENDY_NET_ROUTER
        help
            Opens one lab-only TCP15054 listener. The destination must have a
            current signed mtls-v1 capability and live authorized mesh route.
            All operator TLS remains end-to-end; no operator keys are stored
            on this device. This is a TCP proxy, not intermediate IP routing.
    config WENDY_NET_TEST_AGENT_PROXY_PEER
        string "Integration test: target enrolled device UUID"
        default ""
        depends on WENDY_NET_TEST_AGENT_PROXY
endmenu
