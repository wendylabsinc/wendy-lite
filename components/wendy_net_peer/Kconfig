    config WENDY_NET_TEST_TIME_CONTROL_PEER
        string "Integration test: renew through this router control peer"
        default ""
        depends on WENDY_NET_ROUTER && WENDY_NET_TEST_DIAGNOSTICS
        help
            With station connectivity still available, exercise the ordinary
            encrypted control time relay on the selected authenticated UUID.
