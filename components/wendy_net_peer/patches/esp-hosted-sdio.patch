+/* Wendy's data-only channel uses the normal bounded SDIO queue. Report
+ * backpressure to the caller instead of waiting for a stalled companion. */
+bool wendy_espnow_sdio_send(const uint8_t *bytes, size_t size)
+{
+	if (!is_transport_tx_ready() || !size || size > MAX_PAYLOAD_SIZE)
+		return false;
+	uint8_t *copy = malloc(size);
+	if (!copy)
+		return false;
+	memcpy(copy, bytes, size);
+	interface_buffer_handle_t packet = {
+		.if_type = WNE_SDIO_INTERFACE, .payload_len = size, .payload = copy,
+		.priv_buffer_handle = copy, .free_buf_handle = free,
+	};
+	if (g_h.funcs->_h_queue_item(to_slave_queue[PRIO_Q_OTHERS], &packet, 0) != RET_OK) {
+		free(copy);
+		return false;
+	}
+	g_h.funcs->_h_post_semaphore(sem_to_slave_queue);
+	return true;
+}
