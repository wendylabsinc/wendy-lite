# nanopb field options — string sizes must be bounded for static allocation on MCU

WendyComAppPushDataParams.data   type:FT_CALLBACK
WendyComConfPushDataParams.data  type:FT_CALLBACK
WendyComConsoleData.data         type:FT_CALLBACK

WendyComEnrollmentChallenge.nonce_hex max_size:65
WendyComEnrollmentChallenge.device_id max_size:65
WendyComEnrollmentChallenge.tenant_id max_size:37

WendyComSyncTimeParams.server   type:FT_CALLBACK
WendyComSyncTimeParams.response type:FT_CALLBACK

WendyComEnrollmentResetParams.expected_device_id max_size:13
WendyComEnrollmentResetParams.nonce_hex max_size:65

WendyComNetTopologyPage.tenant max_size:16 fixed_length:true
WendyComNetTopologyPage.device max_size:16 fixed_length:true
WendyComNetTopologyRecord.device max_size:16
WendyComNetTopologyRecord.address max_size:16
WendyComNetTopologyRecord.next_hop_device max_size:16
WendyComNetTopologyRecord.owner_principal type:FT_CALLBACK
WendyComNetTopologyRecord.owner_instance max_size:16
