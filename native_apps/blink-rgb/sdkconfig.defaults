# Flash size: 4 MB
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Move WiFi/PHY hot paths from IRAM to flash (frees ~15-25 KB DIRAM)
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
CONFIG_ESP_PHY_IRAM_OPT=n

# BLE stack (NimBLE) - runs on the host MCU regardless of whether the
# controller is native (C6) or remote-over-VHCI via esp_hosted (P4).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2

# L2CAP connection-oriented channels carry the WendyCom byte stream. Defaults
# to 0 (compiled out), so this is what makes the transport possible at all.
CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247

# Tune NimBLE buffer pools (sized for max 2 connections). These apply
# regardless of whether the controller is native or remote.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=4

# The bundled mbedTLS reassembles handshake records against its configured
# input size. IDF's dynamic allocator can allocate only the current record's
# size, so use fixed buffers to keep that bound equal to the allocation.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=n
# Mixed ML-DSA-65/87 chains need full TLS records plus handshake reassembly.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y

# esp-pqc verifies ML-DSA-65 identities/timestamps and ML-DSA-65/87 CAs.
# Device keys and relay grants remain P-256; PQ key exchange is not required.
CONFIG_LIBOQS_ENABLED=y
CONFIG_LIBOQS_ENABLE_SIG_ML_DSA=y
CONFIG_LIBOQS_ENABLE_KEM_ML_KEM=n
CONFIG_LIBOQS_MLD_HEAP_TEMPORARIES=y
CONFIG_LIBOQS_MLD_VERIFY_ONLY=y
CONFIG_LIBOQS_MINIMAL_COMMON=y
CONFIG_MBEDTLS_USE_BUNDLED_PQC=y
CONFIG_MBEDTLS_SSL_TLS1_3_SIG_MLDSA65=y
CONFIG_MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_GROUP_X25519MLKEM768=n

# PKI uses TLS 1.3 through the bundled esp-pqc mbedTLS component.
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=y

# Sigstore RFC 3161 timestamps use P-384 TSA certificates and SHA-384 chains.
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=y
CONFIG_MBEDTLS_SHA512_C=y

# Console over UART (compatible with Wokwi and most debug setups)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# Disable ROM secondary console so the wendy_core/wendy_usj buffered driver owns
# the USB Serial/JTAG peripheral exclusively.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Size-optimized build (-Os instead of -Og)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTION_LEVEL=1

# Disable stack overflow canary (saves RAM per task)
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_NONE=y
