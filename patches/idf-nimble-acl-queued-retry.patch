+/* Existing host timer, active only while ordinary memory pressure has left
+ * accepted ACL data queued. No extra queue, callout, task or per-link member. */
+void
+ble_hs_sched_tx_retry(void)
+{
+    BLE_HS_DBG_ASSERT(ble_hs_locked_by_cur_task());
+    if (!ble_hs_tx_retry_pending) {
+        ble_hs_tx_retry_due = ble_npl_time_get() + ble_npl_time_ms_to_ticks32(10);
+        ble_hs_tx_retry_pending = true;
+    }
+    int32_t left = (ble_npl_stime_t)(ble_hs_tx_retry_due - ble_npl_time_get());
+    ble_hs_timer_sched(left > 0 ? left : 0);
+}
+
+static int32_t
+ble_hs_tx_retry_timer(void)
+{
+    int32_t left;
+    ble_hs_lock();
+    if (!ble_hs_tx_retry_pending) {
+        ble_hs_unlock();
+        return BLE_HS_FOREVER;
+    }
+    left = (ble_npl_stime_t)(ble_hs_tx_retry_due - ble_npl_time_get());
+    if (left > 0) {
+        ble_hs_unlock();
+        return left;
+    }
+    ble_hs_tx_retry_pending = false;
+    ble_hs_unlock();
+    ble_hs_wakeup_tx();
+    ble_hs_lock();
+    left = ble_hs_tx_retry_pending ?
+        (ble_npl_stime_t)(ble_hs_tx_retry_due - ble_npl_time_get()) : BLE_HS_FOREVER;
+    ble_hs_unlock();
+    return left;
+}
+
