--- a/src/ble_l2cap_sig.c
+++ b/src/ble_l2cap_sig.c
@@ -1797,6 +1797,32 @@
  * $disconnect                                                               *
  *****************************************************************************/
 
+/* Both peers may initiate an ordinary CoC close together. A peer request
+ * completes the channel before our response/timeout does; retire that pending
+ * procedure while the host lock still protects its channel ownership. */
+static struct ble_l2cap_sig_proc *
+ble_l2cap_sig_extract_chan_disconnect(uint16_t conn_handle,
+                                    struct ble_l2cap_chan *chan)
+{
+    struct ble_l2cap_sig_proc *proc;
+    struct ble_l2cap_sig_proc *prev = NULL;
+
+    STAILQ_FOREACH(proc, &ble_l2cap_sig_procs, next) {
+        if (proc->conn_handle == conn_handle &&
+            proc->op == BLE_L2CAP_SIG_PROC_OP_DISCONNECT &&
+            proc->disconnect.chan == chan) {
+            if (prev == NULL) {
+                STAILQ_REMOVE_HEAD(&ble_l2cap_sig_procs, next);
+            } else {
+                STAILQ_REMOVE_AFTER(&ble_l2cap_sig_procs, prev, next);
+            }
+            return proc;
+        }
+        prev = proc;
+    }
+    return NULL;
+}
