+/* Credit notifications share the ordinary signaling pool. Keep only intent
+ * when that pool is busy; accepting an RX SDU still transfers ownership once.
+ * All callers hold the host lock, including the existing host timer driver. */
+static void
+ble_l2cap_coc_credit_flush(struct ble_l2cap_chan *chan)
+{
+    struct ble_l2cap_coc_endpoint *rx = &chan->coc_rx;
+    uint16_t target;
+    int rc;
+
+    BLE_HS_DBG_ASSERT(ble_hs_locked_by_cur_task());
+    if (chan->disable_auto_credit_update ||
+        (chan->flags & BLE_L2CAP_CHAN_F_DISCONNECTING) ||
+        rx->sdus[rx->current_sdu_idx] == NULL) {
+        rx->flags &= ~BLE_L2CAP_COC_RX_CREDITS_PENDING;
+        return;
+    }
+    target = (rx->flags & BLE_L2CAP_COC_RX_CREDITS_INITIAL) ?
+        chan->initial_credits : 1;
+    if (rx->credits >= target) {
+        rx->flags &= ~BLE_L2CAP_COC_RX_CREDITS_PENDING;
+        return;
+    }
+    rc = ble_l2cap_sig_le_credits_locked(chan->conn_handle, chan->scid,
+                                         target - rx->credits);
+    if (rc == 0) {
+        /* Accepted by HCI or its existing connection TX queue. */
+        rx->credits = target;
+        rx->flags &= ~BLE_L2CAP_COC_RX_CREDITS_PENDING;
+    }
+}
+
+static void
+ble_l2cap_coc_credit_request(struct ble_l2cap_chan *chan, uint8_t intent)
+{
+    bool already_pending;
+
+    BLE_HS_DBG_ASSERT(ble_hs_locked_by_cur_task());
+    already_pending = (chan->coc_rx.flags &
+                       BLE_L2CAP_COC_RX_CREDITS_PENDING) != 0;
+    chan->coc_rx.flags |= intent;
+    ble_l2cap_coc_credit_flush(chan);
+    if (!already_pending &&
+        (chan->coc_rx.flags & BLE_L2CAP_COC_RX_CREDITS_PENDING)) {
+        /* One immediate reschedule arms the shared host timer. Repeated
+         * resource pressure is paced by credit_timer, never a zero-delay loop. */
+        ble_hs_timer_resched();
+    }
+}
+
+int32_t
+ble_l2cap_coc_credit_timer(void)
+{
+    struct ble_hs_conn *conn;
+    struct ble_l2cap_chan *chan;
+    int32_t ticks = BLE_HS_FOREVER;
+
+    ble_hs_lock();
+    for (conn = ble_hs_conn_first(); conn != NULL;
+         conn = SLIST_NEXT(conn, bhc_next)) {
+        SLIST_FOREACH(chan, &conn->bhc_channels, next) {
+            if (chan->psm != 0 &&
+                (chan->coc_rx.flags & BLE_L2CAP_COC_RX_CREDITS_PENDING)) {
+                ble_l2cap_coc_credit_flush(chan);
+                if (chan->coc_rx.flags & BLE_L2CAP_COC_RX_CREDITS_PENDING) {
+                    ticks = max(1, ble_npl_time_ms_to_ticks32(10));
+                }
+            }
+        }
+    }
+    ble_hs_unlock();
+    return ticks;
+}
