 cleanup:
+#if defined(MBEDTLS_SSL_KEEP_PEER_CERTIFICATE)
+    if (ssl->conf->wendy_compact_peer_chain && ssl->session_negotiate->peer_cert) {
+        /* On success the complete path and every policy callback have run.
