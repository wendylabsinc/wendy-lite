+#if BLE_L2CAP_SDU_BUFF_CNT > 1
+/* Remote short SDUs can consume one parked buffer per PDU. Bound a deferred
+ * initial refill by the ACTUAL contiguous buffers still armed now, not the
+ * target remembered before old credits/partial bytes were received. */
+static uint16_t
+ble_l2cap_coc_credit_target(struct ble_l2cap_chan *chan)
+{
+    struct ble_l2cap_coc_endpoint *rx = &chan->coc_rx;
+    uint16_t armed = 0, target = 0;
+    for (unsigned i = 0; i < BLE_L2CAP_SDU_BUFF_CNT; i++) {
+        unsigned index = (rx->current_sdu_idx + i) % BLE_L2CAP_SDU_BUFF_CNT;
+        if (rx->sdus[index] == NULL) {
+            break;
+        }
+        armed++;
+    }
+    if (rx->flags & BLE_L2CAP_COC_RX_CREDITS_INITIAL) {
+        target = chan->initial_credits;
+    } else if ((rx->flags & BLE_L2CAP_COC_RX_CREDITS_PARTIAL) && armed &&
+               rx->data_offset > OS_MBUF_PKTLEN(rx->sdus[rx->current_sdu_idx])) {
+        target = 1;
+    }
+    return target < armed ? target : armed;
+}
+#endif
