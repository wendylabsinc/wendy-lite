--- a/src/ble_l2cap_coc.c
+++ b/src/ble_l2cap_coc.c
@@ -67,6 +67,32 @@
 #define max(a, b) ((a) > (b) ? (a) : (b))
 #endif
 
+#if BLE_L2CAP_SDU_BUFF_CNT > 1
+/* Remote short SDUs can consume one parked buffer per PDU. Bound a deferred
+ * initial refill by the ACTUAL contiguous buffers still armed now, not the
+ * target remembered before old credits/partial bytes were received. */
+static uint16_t
+ble_l2cap_coc_credit_target(struct ble_l2cap_chan *chan)
+{
+    struct ble_l2cap_coc_endpoint *rx = &chan->coc_rx;
+    uint16_t armed = 0, target = 0;
+    for (unsigned i = 0; i < BLE_L2CAP_SDU_BUFF_CNT; i++) {
+        unsigned index = (rx->current_sdu_idx + i) % BLE_L2CAP_SDU_BUFF_CNT;
+        if (rx->sdus[index] == NULL) {
+            break;
+        }
+        armed++;
+    }
+    if (rx->flags & BLE_L2CAP_COC_RX_CREDITS_INITIAL) {
+        target = chan->initial_credits;
+    } else if ((rx->flags & BLE_L2CAP_COC_RX_CREDITS_PARTIAL) && armed &&
+               rx->data_offset > OS_MBUF_PKTLEN(rx->sdus[rx->current_sdu_idx])) {
+        target = 1;
+    }
+    return target < armed ? target : armed;
+}
+#endif
+
 /* Credit notifications share the ordinary signaling pool. Keep only intent
  * when that pool is busy; accepting an RX SDU still transfers ownership once.
  * All callers hold the host lock, including the existing host timer driver. */
@@ -84,8 +110,12 @@
         rx->flags &= ~BLE_L2CAP_COC_RX_CREDITS_PENDING;
         return;
     }
+#if BLE_L2CAP_SDU_BUFF_CNT > 1
+    target = ble_l2cap_coc_credit_target(chan);
+#else
     target = (rx->flags & BLE_L2CAP_COC_RX_CREDITS_INITIAL) ?
         chan->initial_credits : 1;
+#endif
     if (rx->credits >= target) {
         rx->flags &= ~BLE_L2CAP_COC_RX_CREDITS_PENDING;
         return;
@@ -363,7 +393,11 @@
          * ble_l2cap_recv_ready). This is a credit/buffer asymmetry — disconnect
          * rather than dereference a NULL pointer.
          */
-        BLE_HS_LOG(ERROR, "CoC RX: no SDU buffer armed (idx=%d), disconnecting\n",
-                   chan->coc_rx.current_sdu_idx);
+        BLE_HS_LOG(ERROR, "CoC RX: no SDU buffer armed "
+                   "(handle=%u cid=%u psm=%u idx=%u alloc=%u credits=%u "
+                   "flags=%u), disconnecting\n",
+                   chan->conn_handle, chan->scid, chan->psm,
+                   rx->current_sdu_idx, rx->next_sdu_alloc_idx,
+                   rx->credits, rx->flags);
         ble_l2cap_disconnect(chan);
         return BLE_HS_ENOMEM;
