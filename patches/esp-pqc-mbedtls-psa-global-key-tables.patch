+/* Keep the initial volatile slice and persistent cache. Secondary slices
+ * may be retired only when every slot is EMPTY: no filling operation, key or
+ * registered reader then retains an address into that allocation. */
+psa_status_t mbedtls_psa_trim_empty_key_slots(size_t *freed_bytes)
+{
+    psa_status_t status = PSA_SUCCESS;
+    if (freed_bytes == NULL) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+    *freed_bytes = 0;
+    if (!psa_get_key_slots_initialized()) {
+        return PSA_ERROR_BAD_STATE;
+    }
+#if defined(MBEDTLS_THREADING_C)
+    PSA_THREADING_CHK_RET(mbedtls_mutex_lock(&mbedtls_threading_key_slot_mutex));
+#endif
+#if defined(MBEDTLS_PSA_KEY_STORE_DYNAMIC)
+    for (size_t slice_idx = 1; slice_idx < KEY_SLOT_VOLATILE_SLICE_COUNT; slice_idx++) {
+        psa_key_slot_t *slice = global_data.key_slices[slice_idx];
+        if (slice == NULL) {
+            continue;
+        }
+        size_t count = key_slice_length(slice_idx), slot_idx = 0;
+        while (slot_idx < count && slice[slot_idx].state == PSA_SLOT_EMPTY) {
+            slot_idx++;
+        }
+        if (slot_idx == count) {
+            global_data.key_slices[slice_idx] = NULL;
+            global_data.first_free_slot_index[slice_idx] = 0;
+            *freed_bytes += count * sizeof(*slice);
+            mbedtls_free(slice);
+        }
+    }
+#endif
+#if defined(MBEDTLS_THREADING_C)
+    PSA_THREADING_CHK_RET(mbedtls_mutex_unlock(&mbedtls_threading_key_slot_mutex));
+#endif
     return status;
 }
 
