-                                          ssl->session_negotiate->peer_cert,
-                                          NULL, NULL);
+    mbedtls_x509_crt *tail=ssl->session_negotiate->peer_cert;
+    if (tail && ssl->handshake->wendy_peer_issuers) {
+        while (tail->next) tail=tail->next;
+        tail->next=ssl->handshake->wendy_peer_issuers;
+    }
+    int ret=mbedtls_ssl_verify_certificate(ssl, authmode,
+                                         ssl->session_negotiate->peer_cert,
+                                         NULL, NULL);
+    /* Restore ownership even when validation fails or requests a restart. */
+    if (tail && ssl->handshake->wendy_peer_issuers) tail->next=NULL;
+    return ret;
 }
