diff --git a/library/ssl_misc.h b/library/ssl_misc.h
--- a/library/ssl_misc.h
+++ b/library/ssl_misc.h
@@ -461,6 +461,10 @@
 #endif /* MBEDTLS_SSL_RECORD_SIZE_LIMIT */
 
 #if defined(MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH)
+/* Grow with all record pointers preserved, or fail without changing the buffer. */
+int mbedtls_ssl_grow_input_buffer(mbedtls_ssl_context *ssl, size_t length);
+void mbedtls_ssl_release_handshake_buffer(mbedtls_ssl_context *ssl);
+
 static inline size_t mbedtls_ssl_get_output_buflen(const mbedtls_ssl_context *ctx)
 {
 #if defined(MBEDTLS_SSL_DTLS_CONNECTION_ID)
diff --git a/library/ssl_tls.c b/library/ssl_tls.c
--- a/library/ssl_tls.c
+++ b/library/ssl_tls.c
@@ -391,6 +391,29 @@
         ssl->in_iv = ssl->in_buf + iv_offset_in;
     }
 }
+/* Wendy: a normal connection needs one TLS record, not the additional
+ * 32KiB reserved for fragmented mixed-CA handshakes. Grow only if such a
+ * message arrives. The existing helper preserves every live record pointer. */
+int mbedtls_ssl_grow_input_buffer(mbedtls_ssl_context *ssl, size_t length)
+{
+    if (length > MBEDTLS_SSL_IN_BUFFER_LEN) {
+        return MBEDTLS_ERR_SSL_BUFFER_TOO_SMALL;
+    }
+    handle_buffer_resizing(ssl, 0, length, ssl->out_buf_len);
+    return ssl->in_buf_len >= length ? 0 : MBEDTLS_ERR_SSL_ALLOC_FAILED;
+}
+
+/* TLS 1.3 retains handshake state for optional post-handshake messages;
+ * unlike TLS 1.2, wrapup does not run handshake_free. Release its temporary
+ * record headroom explicitly while preserving any buffered next record. */
+void mbedtls_ssl_release_handshake_buffer(mbedtls_ssl_context *ssl)
+{
+    if (ssl->in_hsfraglen == 0) {
+        handle_buffer_resizing(ssl, 1, mbedtls_ssl_get_input_buflen(ssl),
+                               mbedtls_ssl_get_output_buflen(ssl));
+    }
+}
+
 #endif /* MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH */
 
 #if defined(MBEDTLS_SSL_PROTO_TLS1_2)
@@ -1003,8 +1026,10 @@
 #if defined(MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH)
     /* If the buffers are too small - reallocate */
 
-    handle_buffer_resizing(ssl, 0, MBEDTLS_SSL_IN_BUFFER_LEN,
-                           MBEDTLS_SSL_OUT_BUFFER_LEN);
+    handle_buffer_resizing(ssl, 0,
+        ssl->conf->transport == MBEDTLS_SSL_TRANSPORT_STREAM ?
+        MBEDTLS_SSL_IN_BUFFER_LEN - MBEDTLS_SSL_HANDSHAKE_HEADROOM : MBEDTLS_SSL_IN_BUFFER_LEN,
+        MBEDTLS_SSL_OUT_BUFFER_LEN);
 #endif
 
     /* All pointers should exist and can be directly freed without issue */
@@ -1180,6 +1205,11 @@
     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
     size_t in_buf_len = MBEDTLS_SSL_IN_BUFFER_LEN;
     size_t out_buf_len = MBEDTLS_SSL_OUT_BUFFER_LEN;
+#if defined(MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH)
+    if (conf->transport == MBEDTLS_SSL_TRANSPORT_STREAM) {
+        in_buf_len -= MBEDTLS_SSL_HANDSHAKE_HEADROOM;
+    }
+#endif
 
     ssl->conf = conf;
 
diff --git a/library/ssl_msg.c b/library/ssl_msg.c
--- a/library/ssl_msg.c
+++ b/library/ssl_msg.c
@@ -2950,6 +2950,24 @@
         }
     }
 
+#if defined(MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH)
+    if (ssl->conf->transport == MBEDTLS_SSL_TRANSPORT_STREAM &&
+        (ssl->in_hsfraglen != 0 || ssl->in_msglen < ssl->in_hslen)) {
+        /* Leave room for a complete next record, including any next handshake
+         * message coalesced with the final fragment. The peer-controlled length
+         * was checked against MAX_HANDSHAKE_LEN above. */
+        size_t required = MBEDTLS_SSL_IN_BUFFER_LEN - MBEDTLS_SSL_HANDSHAKE_HEADROOM
+                          + ssl->in_hslen;
+        if (required > MBEDTLS_SSL_IN_BUFFER_LEN) {
+            required = MBEDTLS_SSL_IN_BUFFER_LEN;
+        }
+        int ret = mbedtls_ssl_grow_input_buffer(ssl, required);
+        if (ret != 0) {
+            return ret;
+        }
+    }
+#endif
+
     MBEDTLS_SSL_DEBUG_MSG(3, ("handshake message: msglen ="
                               " %" MBEDTLS_PRINTF_SIZET ", type = %u, hslen = %"
                               MBEDTLS_PRINTF_SIZET,
diff --git a/library/ssl_tls13_generic.c b/library/ssl_tls13_generic.c
--- a/library/ssl_tls13_generic.c
+++ b/library/ssl_tls13_generic.c
@@ -1425,6 +1425,10 @@
     }
     ssl->session = ssl->session_negotiate;
     ssl->session_negotiate = NULL;
+
+#if defined(MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH)
+    mbedtls_ssl_release_handshake_buffer(ssl);
+#endif
 
     MBEDTLS_SSL_DEBUG_MSG(3, ("<= handshake wrapup"));
 }
